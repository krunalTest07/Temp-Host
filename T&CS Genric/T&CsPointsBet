    .pb-tc-content h3 {
        font-size: 13px;
    }

    .pb-tc-content p,
    .pb-tc-content li {
        font-size: 12px;
        line-height: 1.58;
    }

    .pb-tc-content ol,
    .pb-tc-content ul {
        padding-left: 21px;
    }
}


/* =========================================================
   VERY SMALL MOBILE
