<style>
/* =========================================================
   PB REWARDS CLUB - TERMS & CONDITIONS
   Theme: Black / Purple / Hot Pink / Gold
   ========================================================= */

:root {
    --pb-bg: #08070c;
    --pb-bg-2: #100b17;
    --pb-card: #0d0b12;
    --pb-card-2: #15101c;

    --pb-pink: #ff0050;
    --pb-pink-light: #ff174f;
    --pb-pink-soft: rgba(255, 0, 80, 0.15);

    --pb-gold: #ffbf00;
    --pb-gold-soft: rgba(255, 191, 0, 0.15);

    --pb-white: #ffffff;
    --pb-text: #e9e7ec;
    --pb-muted: #aaa6b0;
    --pb-border: rgba(255,255,255,0.10);
}

/* Reset only inside T&C */
.pb-tc,
.pb-tc * {
    box-sizing: border-box;
}

.pb-tc {
    width: 100%;
    max-width: 760px;
    height: 100%;
    margin: 0 auto;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    color: var(--pb-text);
    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(110, 0, 150, 0.20),
            transparent 42%
        ),
        linear-gradient(
            180deg,
            #0b0810 0%,
            #08070c 100%
        );

    line-height: 1.55;
    font-size: 14px;

    overflow-y: auto;
    overflow-x: hidden;

    padding: 0 24px 30px;

    scrollbar-width: thin;
    scrollbar-color: var(--pb-pink) #18131d;
}

/* Chrome / Edge / Safari scrollbar */
.pb-tc::-webkit-scrollbar {
    width: 6px;
}

.pb-tc::-webkit-scrollbar-track {
    background: #18131d;
}

.pb-tc::-webkit-scrollbar-thumb {
    background: var(--pb-pink);
    border-radius: 10px;
}

.pb-tc::-webkit-scrollbar-thumb:hover {
    background: var(--pb-pink-light);
}


/* =========================================================
   HEADER
   ========================================================= */

.pb-tc-header {
    position: sticky;
    top: 0;
    z-index: 20;

    padding: 22px 0 18px;

    background:
        linear-gradient(
            180deg,
            rgba(8,7,12,0.98) 0%,
            rgba(8,7,12,0.94) 75%,
            rgba(8,7,12,0) 100%
        );

    border-bottom: 1px solid rgba(255,255,255,0.04);
}

.pb-tc-label {
    display: inline-flex;
    align-items: center;

    padding: 5px 9px;

    margin-bottom: 10px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.7px;
    text-transform: uppercase;

    color: #111;
    background: var(--pb-gold);

    border-radius: 3px;
}

.pb-tc-title {
    margin: 0;

    color: var(--pb-white);

    font-size: 25px;
    line-height: 1.15;
    font-weight: 800;

    letter-spacing: -0.4px;
}

.pb-tc-title::after {
    content: "";
    display: block;

    width: 42px;
    height: 3px;

    margin-top: 10px;

    background: var(--pb-pink);
    border-radius: 5px;

    box-shadow: 0 0 10px rgba(255,0,80,0.45);
}

.pb-tc-subtitle {
    margin: 11px 0 0;

    color: var(--pb-muted);

    font-size: 12px;
    line-height: 1.5;
}


/* =========================================================
   DOCUMENT CONTENT
   ========================================================= */

.pb-tc-content {
    padding-top: 10px;
}

.pb-tc-content h2 {
    position: relative;

    margin: 28px 0 12px;
    padding: 0 0 8px 13px;

    color: var(--pb-white);

    font-size: 17px;
    line-height: 1.25;

    font-weight: 800;

    border-bottom: 1px solid var(--pb-border);
}

.pb-tc-content h2::before {
    content: "";

    position: absolute;
    left: 0;
    top: 1px;

    width: 4px;
    height: calc(100% - 8px);

    background: var(--pb-pink);
    border-radius: 4px;

    box-shadow: 0 0 8px rgba(255,0,80,0.35);
}

.pb-tc-content h3 {
    margin: 21px 0 8px;

    color: #f5f3f7;

    font-size: 14px;
    line-height: 1.35;

    font-weight: 750;
}

.pb-tc-content p {
    margin: 0 0 11px;

    color: var(--pb-text);

    font-size: 13px;
    line-height: 1.62;
}

.pb-tc-content strong {
    color: #ffffff;
    font-weight: 700;
}


/* =========================================================
   LISTS
   ========================================================= */

.pb-tc-content ol,
.pb-tc-content ul {
    margin: 8px 0 16px;
    padding-left: 24px;
}

.pb-tc-content li {
    margin: 0 0 9px;

    padding-left: 4px;

    color: var(--pb-text);

    font-size: 13px;
    line-height: 1.6;
}

.pb-tc-content ol > li::marker {
    color: var(--pb-pink);
    font-weight: 700;
}

.pb-tc-content ul > li::marker {
    color: var(--pb-gold);
}


/* Nested lists */
.pb-tc-content li ol,
.pb-tc-content li ul {
    margin-top: 8px;
    margin-bottom: 6px;
}

.pb-tc-content li li {
    margin-bottom: 6px;
}


/* =========================================================
   LINKS
   ========================================================= */

.pb-tc-content a {
    color: var(--pb-gold);

    text-decoration: none;
    font-weight: 600;

    transition:
        color 0.2s ease,
        text-shadow 0.2s ease;
}

.pb-tc-content a:hover {
    color: #ffd45c;

    text-shadow:
        0 0 8px rgba(255,191,0,0.35);
}


/* =========================================================
   IMPORTANT / INFO BLOCKS
   ========================================================= */

.pb-tc-info {
    margin: 18px 0;
    padding: 14px 16px;

    background:
        linear-gradient(
            135deg,
            rgba(255,0,80,0.09),
            rgba(100,0,130,0.08)
        );

    border: 1px solid rgba(255,0,80,0.18);
    border-left: 3px solid var(--pb-pink);

    border-radius: 7px;
}

.pb-tc-info p {
    margin: 0;
}


/* =========================================================
   VERSION / META
   ========================================================= */

.pb-tc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    margin: 12px 0 6px;
}

.pb-tc-meta span {
    display: inline-flex;
    align-items: center;

    min-height: 25px;

    padding: 4px 9px;

    background: rgba(255,255,255,0.05);

    border: 1px solid rgba(255,255,255,0.08);

    border-radius: 4px;

    color: var(--pb-muted);

    font-size: 10px;
    font-weight: 600;
}


/* =========================================================
   FOOTER
   ========================================================= */

.pb-tc-footer {
    margin-top: 35px;
    padding: 20px 0 10px;

    text-align: center;

    border-top: 1px solid rgba(255,255,255,0.08);

    color: #77727d;

    font-size: 10px;
    line-height: 1.5;
}

.pb-tc-footer strong {
    color: var(--pb-gold);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

    .pb-tc {
        max-width: 100%;
        padding: 0 17px 25px;

